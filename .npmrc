# Dependencies' install scripts do not run, locally as in CI, which already installs with
# --ignore-scripts. Nothing here needs one: the only two are fsevents (macOS only) and
# lfa-ponyfill's font-list refresh. Scripts in package.json still run when asked for by name.
# A dependency that one day needs its script: npm rebuild <package> --ignore-scripts=false
ignore-scripts=true
