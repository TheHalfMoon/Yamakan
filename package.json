{
  "name": "yamakan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "node --watch server/main.ts",
    "build": "tsc --noEmit && vite build",
    "start": "node server/main.ts",
    "test": "node --test tests/*.test.ts tests/*.test.mjs src/editor/utils/*.test.ts",
    "test:studio": "node --test tests/studio.test.ts && npx vitest run src/studio",
    "typecheck": "tsc --noEmit",
    "cli": "node cli/main.ts",
    "open": "node cli/open.ts",
    "lint": "oxlint --deny-warnings core server cli sdk mcp src/main.tsx src/adapter.ts src/edit-ops.ts src/reference.tsx src/i18n.ts src/session.ts tests scripts",
    "format": "prettier --write \"core/*.ts\" core/command server cli sdk mcp src/main.tsx src/adapter.ts src/style.css tests scripts vite.config.ts tsconfig.json package.json",
    "format:check": "prettier --check \"core/*.ts\" core/command server cli sdk mcp src/main.tsx src/adapter.ts src/style.css tests scripts vite.config.ts tsconfig.json package.json",
    "test:e2e": "node scripts/browser-e2e.mjs",
    "test:e2e:studio": "node e2e/testerarmy/run.mjs",
    "provenance:check": "node scripts/provenance.mjs",
    "brand:check": "node scripts/brand-check.mjs",
    "benchmark": "node scripts/benchmark-production.ts",
    "mcp": "node mcp/main.ts",
    "migrate": "node cli/migrate.ts",
    "recovery": "node cli/recovery.ts",
    "build:native": "cargo build --release --manifest-path native/procd/Cargo.toml",
    "qualify:large-import": "node scripts/qualify-large-import.mjs",
    "qualify:typography": "node scripts/qualify-typography.ts",
    "qualify:preview": "node scripts/qualify-preview.ts",
    "qualify:resources": "node scripts/qualify-resources.ts",
    "qualify:q1": "node scripts/qualify-q1-has-audio.ts",
    "qualify:q5": "node scripts/qualify-q5-mediabunny.mjs",
    "qualify:q6": "node scripts/qualify-q6-atempo.ts",
    "qualify:q13": "node scripts/qualify-q13-animation.ts",
    "qualify:q14": "node scripts/qualify-q14-animation-params.ts",
    "qualify:animation-e2e": "node scripts/qualify-animation-e2e.ts",
    "qualify:q15": "node scripts/qualify-q15-user-presence.ts",
    "qualify:q8": "node scripts/qualify-q8-studio.mjs",
    "qualify:q10": "node scripts/qualify-q10-studio.mjs",
    "qualify:studio-activation": "node scripts/qualify-studio-activation.mjs",
    "qualify:quality-lab": "node scripts/qualify-quality-lab.mjs",
    "qualify:cinema-activation": "node scripts/qualify-cinema-activation.mjs",
    "qualify:director-activation": "node scripts/qualify-director-activation.mjs",
    "qualify:q11-jassub-eng": "node scripts/qualify-q11-jassub-eng.mjs",
    "qualify:bundle-r6": "node scripts/qualify-bundle-r6.mjs",
    "qualify:unsigned-rc": "node scripts/qualify-unsigned-rc.mjs",
    "qualify:w18-loudnorm": "node scripts/qualify-w18-loudnorm.ts",
    "qualify:av-sync": "node scripts/qualify-av-sync.ts",
    "qualify:playback": "node scripts/qualify-playback.mjs",
    "qualify:release": "node scripts/qualify-release.ts",
    "qualify:release-evidence": "node scripts/qualify-release-evidence.ts",
    "qualify:ultimate-baseline": "node scripts/qualify-ultimate-baseline.mjs",
    "qualify:ultimate-environment": "node scripts/qualify-ultimate-environment.mjs",
    "bundle": "node scripts/bundle.ts",
    "bundle:install-dev": "node scripts/bundle.ts install-dev",
    "bundle:pack-unsigned-rc": "node scripts/bundle.ts pack-unsigned-rc",
    "benchmark:ultimate": "node scripts/benchmark-ultimate.ts"
  },
  "dependencies": {
    "ag-psd": "31.0.3",
    "jassub": "2.5.20",
    "mediabunny": "1.61.3",
    "perfect-freehand": "1.2.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "soundtouchjs": "0.3.0",
    "three": "0.171.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/three": "0.171.0",
    "@vitejs/plugin-react": "6.1.2",
    "oxlint": "1.87.0",
    "playwright-core": "1.64.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "4.1.12"
  }
}
