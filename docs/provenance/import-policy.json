{
  "policy": "yamakan.import-policy/v1",
  "donorRoots": [
    "src/donors",
    "core/donors",
    "src/studio/canvas-engine",
    "src/studio/host",
    "src/cinema",
    "core/director",
    "core/engines"
  ],
  "sourceNotices": [
    {
      "source": "LudwigKienle/ai-video-production-editor",
      "notices": ["notices/ai-video-production-editor-LICENSE"]
    },
    {
      "source": "TheHalfMoon/Ninerr",
      "notices": ["notices/Ninerr-LICENSE"]
    },
    {
      "source": "OpenCut-app/opencut-classic",
      "notices": ["notices/OpenCut-LICENSE"]
    },
    {
      "source": "Vanilagy/mediabunny",
      "notices": ["notices/mediabunny-LICENSE"]
    },
    {
      "source": "soundtouchjs",
      "notices": ["notices/soundtouchjs-LICENSE"]
    },
    {
      "source": "storytold/artcraft",
      "notices": [
        "notices/ArtCraft-LICENSE-MIT",
        "notices/ArtCraft-LICENSE-APACHE",
        "notices/ArtCraft-NOTICE"
      ]
    },
    {
      "source": "mne03005-png/OpenVideoStudio",
      "notices": [
        "notices/OpenVideoStudio-LICENSE",
        "notices/OpenVideoStudio-NOTICE"
      ]
    },
    {
      "source": "calesthio/OpenMontage",
      "notices": ["notices/OpenMontage-LICENSE"]
    }
  ],
  "localFilesInDonorRoots": [
    {
      "path": "src/donors/film-editor/libraryAsset.ts",
      "reason": "Yamakan-authored type shim isolating the donor LibraryAsset type from its cloud-backed library hook (see Timeline.tsx ledger modification)."
    },
    {
      "path": "core/donors/opencut/timeline-types.ts",
      "reason": "Yamakan-authored type surface for OpenCut ripple/group-move ports (M3/M4); replaces donor @/timeline/types."
    },
    {
      "path": "core/donors/opencut/adapters.ts",
      "reason": "Yamakan adapters replacing the five non-copied OpenCut group-move dependencies (track lookup, kind compatibility, snap sources) and SceneTracks projection."
    },
    {
      "path": "core/donors/opencut/retime/atempo.ts",
      "reason": "Yamakan helper building FFmpeg atempo filter chains for rational rates (Q6); not from OpenCut."
    },
    {
      "path": "core/engines/contract.ts",
      "reason": "Yamakan-authored M13 engine adapter contract (W10); no donor copy."
    },
    {
      "path": "core/engines/fake.ts",
      "reason": "Yamakan-authored fake engine for cancel/fencing/quarantine tests (W10); no donor copy."
    }
  ],
  "excludedPaths": [
    {
      "pattern": "(^|/)electron/main\\.js$",
      "source": "LudwigKienle/ai-video-production-editor",
      "reason": "Unsafe Electron shell: unrestricted filesystem and renderer-to-shell IPC."
    },
    {
      "pattern": "(^|/)preload\\.js$",
      "source": "LudwigKienle/ai-video-production-editor",
      "reason": "Renderer bridge exposing privileged desktop IPC."
    },
    {
      "pattern": "(^|/)local-agents\\.js$",
      "source": "LudwigKienle/ai-video-production-editor",
      "reason": "Arbitrary local command execution."
    },
    {
      "pattern": "(^|/)midjourney-agent\\.js$",
      "source": "LudwigKienle/ai-video-production-editor",
      "reason": "Consumer-session automation of a third-party service."
    },
    {
      "pattern": "(^|/)studio-mcp-server\\.js$",
      "source": "LudwigKienle/ai-video-production-editor",
      "reason": "Unbounded MCP server with desktop shell access."
    },
    {
      "pattern": "(^|/)browser_emulation(/|$)",
      "source": "storytold/artcraft",
      "reason": "Browser TLS-fingerprint spoofing and bot-protection bypass."
    },
    {
      "pattern": "(^|/)(cookie|cookies|session)[-_]?(client|store|jar)[^/]*$",
      "source": "storytold/artcraft",
      "reason": "Consumer cookie/session impersonation clients."
    },
    {
      "pattern": "(^|/)src-tauri/(capabilities|tauri\\.conf\\.json)",
      "source": "storytold/artcraft",
      "reason": "Desktop configurations granting broad filesystem/shell capabilities."
    },
    {
      "pattern": "(^|/)crates/desktop/artcraft/(tauri\\.conf\\.json|capabilities/default\\.json)$",
      "source": "storytold/artcraft",
      "reason": "Desktop configurations granting broad filesystem/shell capabilities."
    },
    {
      "pattern": "(^|/)crates/api_clients/(openai_sora_client|grok_consumer_client|midjourney_client|worldlabs_consumer_client|kinovi_web_client)(/|$)",
      "source": "storytold/artcraft",
      "reason": "Consumer-session cookie authentication clients."
    },
    {
      "pattern": "(^|/)electron/lib/localInference\\.js$",
      "source": "Anil-matcha/Open-Generative-AI",
      "reason": "Silent retrying model downloads without idempotency."
    },
    {
      "pattern": "(^|/)app/api/",
      "source": "Anil-matcha/Open-Generative-AI",
      "reason": "Single-aggregator provider proxies."
    },
    {
      "pattern": "(^|/)studio/core/render\\.py$",
      "source": "mne03005-png/OpenVideoStudio",
      "reason": "Alternate renderer; FFmpeg render plan is the single rendering authority."
    },
    {
      "pattern": "(^|/)muapi[^/]*\\.(js|ts)$",
      "source": "Anil-matcha/Open-Generative-AI",
      "reason": "Unqualified provider submit/poll proxy with ambiguous billing retries."
    },
    {
      "pattern": "(^|/)core/managers(/|$)",
      "source": "OpenCut-app/opencut-classic",
      "reason": "Second persisted authority (OpenCut EditorCore managers)."
    },
    {
      "pattern": "(^|/)services/storage/(indexeddb|opfs)-adapter\\.ts$",
      "source": "OpenCut-app/opencut-classic",
      "reason": "Second persisted authority (IndexedDB/OPFS storage adapters)."
    },
    {
      "pattern": "(^|/)services/renderer/scene-exporter\\.ts$",
      "source": "OpenCut-app/opencut-classic",
      "reason": "In-memory export authority conflicting with Yamakan render plan."
    }
  ],
  "processSpawnAllowlist": [
    "core/process/owner.ts",
    "core/process/access.ts",
    "core/render.ts"
  ],
  "productionRoots": ["core", "server", "cli", "sdk", "mcp", "src"]
}
